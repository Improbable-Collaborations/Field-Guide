{
  "name": "finsbury-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hitchhiker's Guide to Finsbury Park (London) \u2014 MapLibre + Field Guide Web4 Client",
  "scripts": {
    "dev": "concurrently -k \"npm run mcp\" \"vite\"",
    "mcp": "tsx src/mcp/http.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "field-guide-web4-client": "file:../clients/field-guide-web4-client",
    "maplibre-gl": "^4.7.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.170.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^4.1.11"
  }
}
